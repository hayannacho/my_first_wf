// One paired-end sample per run. Default inputs are the archived coursework subset.
params.read1 = "${projectDir}/data/mini_1.fastq"
params.read2 = "${projectDir}/data/mini_2.fastq"
params.outdir = 'output'

process {
    cpus = 2
    withName: spades {
        memory = '4 GB'
    }
}

profiles {
    docker {
        process.executor = 'local'
        docker.enabled = true
    }
}
